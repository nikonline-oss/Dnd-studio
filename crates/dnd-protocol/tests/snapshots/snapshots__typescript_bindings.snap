// This file has been generated by Specta. Do not edit this file manually.
/**  An intent was applied; `seq` is the last event it produced. */
export type Acceptance = {
	intent_id: IntentId,
	seq: Seq,
};

/**
 *  An imported image. Files are content-addressed by SHA-256 (ADR-0004): `sha256` is the original
 *  upload (dedup key), the others are derived WebP files served to the webview.
 */
export type AssetDto = {
	id: AssetId,
	usage: AssetUsage,
	sha256: string,
	mime: string,
	size_bytes: number,
	original_name: string | null,
	/**  Pixel size after any downscaling on import. */
	width: number,
	height: number,
	/**  Whole image as WebP (`None` for maps, which are drawn from tiles). */
	display_sha256: string | null,
	thumbnail_sha256: string,
	/**  Map tiles, row by row; empty for tokens. */
	tiles: AssetTileDto[],
	/**  Its folder in the library (ADR-0026); `None`: the library's root. */
	folder_id?: LibraryFolderId | null,
	version: Version,
};

/**  An imported asset (image, audio, ...). */
export type AssetId = string;

/**  One 2048² (or smaller, at the edges) tile of a map image, in image pixels. */
export type AssetTileDto = {
	x: number,
	y: number,
	width: number,
	height: number,
	/**  SHA-256 (hex) of the tile's WebP file. */
	sha256: string,
};

/**  What an imported image is for (decides size limits and tiling, ADR-0017). */
export type AssetUsage = 
/**  Map background: cut into 2048² WebP tiles, at most 16 384 px per side. */
"map" | 
/**  Token or portrait: one WebP, at most 2048 px per side. */
"token" | 
/**
 *  Music or a sound (ADR-0026): the file as imported, served as `<sha256>.audio`; no pixels,
 *  no tiles, `display_sha256` and `thumbnail_sha256` are its own hash.
 */
"audio";

/**  A board: one center tab of elements. */
export type BoardDto = {
	id: BoardId,
	name: string,
	/**  Order in the board list (ascending). */
	sort_order: number,
	/**  Players see the board (and its elements open to players). */
	visible_to_players: boolean,
	version: Version,
};

/**  A connection between two nodes of the same board. */
export type BoardEdgeDto = {
	id: BoardEdgeId,
	board_id: BoardId,
	from: BoardNodeId,
	to: BoardNodeId,
	/**  Caption on the line; may be empty. */
	label: string,
	/**  Drawn with an arrow towards `to`. */
	directed: boolean,
	/**  Players see it only when it and both its nodes are open to them. */
	visibility: BoardVisibility,
	version: Version,
};

/**  A connection between two board nodes. */
export type BoardEdgeId = string;

/**  A board (ADR-0024). */
export type BoardId = string;

/**  What a link node opens. */
export type BoardLink = { kind: "map"; id: MapId } | { kind: "journal"; id: JournalEntryId } | { kind: "character"; id: CharacterId };

/**  What a node shows. */
export type BoardNodeContent = 
/**  A card with Markdown text (at most [`MAX_NOTE_LEN`] characters). */
{ type: "note"; markdown: string } | 
/**  A card that opens a map, a journal entry or a character sheet. */
{ type: "link"; target: BoardLink } | 
/**  A picture from the campaign's assets. */
{ type: "image"; asset_id: AssetId } | 
/**  A trigger as a block: GM roles only, whatever the node's visibility says. */
{ type: "trigger"; id: TriggerId };

/**  An element of a board. Position and size in Units16 (ADR-0016), the top-left corner. */
export type BoardNodeDto = {
	id: BoardNodeId,
	board_id: BoardId,
	content: BoardNodeContent,
	x: number,
	y: number,
	width: number,
	height: number,
	visibility: BoardVisibility,
	version: Version,
};

/**  An element (card) of a board. */
export type BoardNodeId = string;

/**  Who sees a board element. */
export type BoardVisibility = 
/**  GM roles only (the default for new elements). */
"gm" | 
/**  Everyone who sees the board. */
"players";

/**  Campaign-wide metadata (singleton entity). */
export type CampaignMeta = {
	name: string,
	description: string,
	version: Version,
};

/**
 *  A character. `sheet_json` is the raw sheet (a JSON object, integers only — ADR-0016) until
 *  declarative sheets arrive with system plugins in stage 3.
 */
export type CharacterDto = {
	id: CharacterId,
	kind: CharacterKind,
	name: string,
	owner: UserId | null,
	status: CharacterStatus,
	sheet_json: string,
	/**  Ids of the system's conditions that apply (ADR-0024); stored before conditions existed: empty. */
	conditions?: string[],
	version: Version,
};

/**  A character sheet. */
export type CharacterId = string;

/**  Player character or non-player character. */
export type CharacterKind = "pc" | "npc";

/**  Lifecycle of a character (CLAUDE.md §5): draft → pending_approval → active → archived. */
export type CharacterStatus = "draft" | "pending_approval" | "active" | "archived";

/**  What a chat message is. */
export type ChatKind = "text" | 
/**  Produced by the core; see [`SystemMessage`]. */
"system" | "roll";

/**  A chat message. */
export type ChatMessageDto = {
	id: ChatMessageId,
	kind: ChatKind,
	/**  `None` for system messages and after the sender was deleted. */
	sender: UserId | null,
	/**  The sender's name when the message was written (ADR-0008). */
	sender_name: string,
	/**  Text for `text`; the expression as typed for `roll`; empty for `system`. */
	body: string,
	roll: DiceRollDto | null,
	system: SystemMessage | null,
	visibility: ChatVisibility,
	/**  When it was stored (unix ms); `None` in live events (the core has no clock). */
	at_ms: number | null,
};

/**  A chat message (a dice roll is a chat message too). */
export type ChatMessageId = string;

/**  Who may see a chat message. */
export type ChatVisibility = "all" | 
/**  Hidden GM rolls: GM and Co-GM only (filtering per recipient — stage 4). */
"gm";

/**  Client → server. */
export type ClientMessage = { type: "intent"; payload: IntentEnvelope } | { type: "ping" } | { type: "resync"; payload: {
	last_seq: Seq,
} } | 
/**  The text of a journal entry (snapshots carry only the index). */
{ type: "get_journal_entry"; payload: {
	id: JournalEntryId,
} };

/**  A combat on a map (ADR-0020): the turn order of its combatants. At most one per map. */
export type CombatDto = {
	id: CombatId,
	map_id: MapId,
	/**  Starts at 1; grows when the turn wraps around. */
	round: number,
	/**  Whose turn it is; `None` until the first `next_turn`. */
	turn: CombatantId | null,
	version: Version,
};

/**  A combat (initiative order) on a map. */
export type CombatId = string;

/**  A participant of a combat: usually a token, possibly linked to a character. */
export type CombatantDto = {
	id: CombatantId,
	combat_id: CombatId,
	/**  `None` for a combatant without a token, or after its token was deleted. */
	token_id: TokenId | null,
	/**  The sheet the initiative formula reads (and who owns the combatant). */
	character_id: CharacterId | null,
	name: string,
	/**  `None` until rolled or set. */
	initiative: number | null,
	/**  Order of joining; breaks ties in initiative. */
	sort_order: number,
	version: Version,
};

/**  A participant of a combat. */
export type CombatantId = string;

/**  A condition of the system (poisoned, prone, …), shown on sheets and tokens (ADR-0024). */
export type ConditionDef = {
	id: string,
	label: Label,
};

/**  Result of a dice roll (ADR-0005, ADR-0016: all numbers are integers). */
export type DiceRollDto = {
	/**  Canonical form of the expression. */
	expression: string,
	terms: DiceTermDto[],
	total: number,
};

/**  One term of a roll: dice (with each die), a constant or a sheet field. */
export type DiceTermDto = {
	negative: boolean,
	/**  Canonical notation: `4d6kh3`, `5`, `@str_mod`. */
	notation: string,
	/**  Value before the sign is applied. */
	subtotal: number,
	dice: DieDto[],
};

/**  One physical die of a roll. */
export type DieDto = {
	value: number,
	/**  `false` if dropped by keep/drop or advantage/disadvantage. */
	kept: boolean,
};

/**  A fact about a state change. */
export type Event = { kind: "campaign_meta_updated"; campaign: CampaignMeta } | { kind: "map_created"; map: MapDto } | { kind: "map_updated"; map: MapDto } | { kind: "map_deleted"; id: MapId } | 
/**  Appended to the map's fog; applying the same `op.id` twice adds it once. */
{ kind: "fog_applied"; map_id: MapId; op: FogOp } | 
/**  The map's fog now has no operations, only the initial state. */
{ kind: "fog_reset"; map_id: MapId; covered: boolean } | { kind: "token_created"; token: TokenDto } | { kind: "token_updated"; token: TokenDto } | { kind: "token_moved"; id: TokenId; x: number; y: number } | { kind: "token_deleted"; id: TokenId } | { kind: "character_created"; character: CharacterDto } | 
/**  Any change: name, sheet, status, owner. */
{ kind: "character_updated"; character: CharacterDto } | { kind: "journal_entry_created"; entry: JournalEntryDto } | 
/**  Any change: text, title, folder, order, visibility. */
{ kind: "journal_entry_updated"; entry: JournalEntryDto } | { kind: "journal_entry_deleted"; id: JournalEntryId } | { kind: "journal_folder_created"; folder: JournalFolderDto } | 
/**  Renamed or moved. */
{ kind: "journal_folder_updated"; folder: JournalFolderDto } | 
/**
 *  The folder only: deleting a folder also sends the deletion of everything in it, entries
 *  and subfolders first.
 */
{ kind: "journal_folder_deleted"; id: JournalFolderId } | { kind: "asset_registered"; asset: AssetDto } | { kind: "combat_started"; combat: CombatDto } | 
/**  Round or turn changed. */
{ kind: "combat_updated"; combat: CombatDto } | 
/**  The combat and all its combatants are gone. */
{ kind: "combat_ended"; id: CombatId } | { kind: "combatant_added"; combatant: CombatantDto } | 
/**  Initiative changed. */
{ kind: "combatant_updated"; combatant: CombatantDto } | { kind: "combatant_removed"; id: CombatantId } | 
/**  A text, roll or system message. */
{ kind: "chat_message_posted"; message: ChatMessageDto } | 
/**
 *  A participant of a session became (or already is) a user of the campaign. Produced by the
 *  session server when someone joins, not by an intent (ADR-0022).
 */
{ kind: "user_joined"; user: UserDto } | 
/**  A plugin is installed (or replaced) in the campaign (ADR-0023). */
{ kind: "plugin_installed"; plugin: PluginDto } | { kind: "plugin_uninstalled"; id: string } | 
/**  The campaign's rules changed. */
{ kind: "system_plugin_set"; id: string | null } | 
/**  A board appeared (ADR-0024). */
{ kind: "board_created"; board: BoardDto } | 
/**  Renamed, shown to or hidden from players. */
{ kind: "board_updated"; board: BoardDto } | 
/**  Its nodes and edges were deleted by earlier events of the batch. */
{ kind: "board_deleted"; id: BoardId } | { kind: "board_node_created"; node: BoardNodeDto } | { kind: "board_node_updated"; node: BoardNodeDto } | 
/**  Last-write-wins position; does not bump the version. */
{ kind: "board_node_moved"; id: BoardNodeId; x: number; y: number } | 
/**  Its edges were deleted by earlier events of the batch. */
{ kind: "board_node_deleted"; id: BoardNodeId } | { kind: "board_edge_created"; edge: BoardEdgeDto } | { kind: "board_edge_updated"; edge: BoardEdgeDto } | { kind: "board_edge_deleted"; id: BoardEdgeId } | 
/**  A zone on a map (ADR-0024); GM roles only. */
{ kind: "zone_created"; zone: ZoneDto } | { kind: "zone_updated"; zone: ZoneDto } | { kind: "zone_deleted"; id: ZoneId } | 
/**  A trigger (ADR-0024); GM roles only. */
{ kind: "trigger_created"; trigger: TriggerDto } | 
/**  Edited, or a `once` trigger fired. */
{ kind: "trigger_updated"; trigger: TriggerDto } | { kind: "trigger_deleted"; id: TriggerId } | 
/**  A trigger fired; its effects follow as ordinary events. GM roles only. */
{ kind: "trigger_fired"; fired: TriggerFiredDto } | 
/**  Library folders (ADR-0026). GM roles only. */
{ kind: "library_folder_created"; folder: LibraryFolderDto } | { kind: "library_folder_updated"; folder: LibraryFolderDto } | { kind: "library_folder_deleted"; id: LibraryFolderId } | 
/**  An asset was moved to another folder or renamed. */
{ kind: "asset_updated"; asset: AssetDto } | 
/**  A sound starts for everyone (a looping one stays in `sounds` until stopped). */
{ kind: "sound_played"; sound: SoundDto } | 
/**  A looping sound stops; `None`: every sound stops. */
{ kind: "sound_stopped"; asset_id: AssetId | null } | 
/**
 *  Stands in for an event the recipient may not see, so sequence numbers stay contiguous
 *  (ADR-0022). Never stored; applying it changes nothing.
 */
{ kind: "redacted" };

/**  Events produced by one accepted intent. Event `i` of the batch has sequence number `seq + i`. */
export type EventBatch = {
	/**  Sequence number of the first event in `events`. */
	seq: Seq,
	/**  The intent that caused these events, if any. */
	caused_by: IntentId | null,
	events: Event[],
};

/**
 *  Fog of war of one map: covered or clear at first, then the operations in order. A map
 *  without fog has none (same as `covered: false` with no operations).
 */
export type FogDto = {
	map_id: MapId,
	covered: boolean,
	ops: FogOp[],
};

/**  One fog-of-war operation. Operations are applied in order over the initial state (ADR-0019). */
export type FogOp = {
	id: FogOpId,
	kind: FogOpKind,
	shape: FogShape,
};

/**  One fog-of-war operation (makes re-applying an event idempotent). */
export type FogOpId = string;

/**  Whether a fog operation uncovers or covers its shape. */
export type FogOpKind = "reveal" | "hide";

/**  The area of a fog operation, in Units16 (ADR-0016, ADR-0019). */
export type FogShape = 
/**  Axis-aligned rectangle with its top-left corner at (`x`, `y`). */
{ type: "rect"; x: number; y: number; width: number; height: number } | 
/**  A stroke: circles of `radius` swept along the polyline `points`. */
{ type: "brush"; radius: number; 
/**  Flat `[x0, y0, x1, y1, …]`, 1..=[`MAX_BRUSH_POINTS`] points. */
points: number[] };

/**  Grid settings of a map. Lengths are in logical map units (ADR-0016). */
export type Grid = {
	kind: GridKind,
	cell_size: number,
	offset_x: number,
	offset_y: number,
};

/**  Grid geometry of a map. */
export type GridKind = "none" | "square" | "hex_flat" | "hex_pointy";

/**  A request to change state. Update intents carry only the fields to change (`null` = keep). */
export type Intent = { kind: "update_campaign_meta"; name: string | null; description: string | null } | { kind: "create_map"; id: MapId; name: string; background_asset_id: AssetId | null; 
/**  Logical size (ADR-0016), `1..=MAX_MAP_SIZE`; fixed for the life of the map. */
width: number; height: number; grid: Grid; visible_to_players: boolean } | { kind: "update_map"; id: MapId; name: string | null; grid: Grid | null; visible_to_players: boolean | null } | { kind: "delete_map"; id: MapId } | 
/**
 *  GM / Co-GM. Appends a reveal/hide operation to the map's fog (ADR-0019). The shape must
 *  lie on the map; `op.id` is a new UUIDv7. Does not change the map version.
 */
{ kind: "apply_fog"; map_id: MapId; op: FogOp } | 
/**  GM / Co-GM. Drops every fog operation: the whole map becomes covered or clear. */
{ kind: "reset_fog"; map_id: MapId; covered: boolean } | 
/**  GM / Co-GM. Opens a combat on a map (one per map), round 1, nobody's turn yet (ADR-0020). */
{ kind: "start_combat"; id: CombatId; map_id: MapId } | 
/**  GM / Co-GM. A token of the combat's map (each at most once) and/or a character. */
{ kind: "add_combatant"; id: CombatantId; combat_id: CombatId; token_id: TokenId | null; character_id: CharacterId | null; name: string } | 
/**  GM / Co-GM. If it was their turn, the turn passes to the next combatant. */
{ kind: "remove_combatant"; id: CombatantId } | 
/**
 *  GM / Co-GM, or the owner of the combatant's character. Rolls the initiative formula
 *  against the character's sheet; the roll is posted to chat.
 */
{ kind: "roll_initiative"; id: CombatantId } | 
/**  GM / Co-GM. Sets (or clears) a combatant's initiative by hand. */
{ kind: "set_initiative"; id: CombatantId; initiative: number | null } | 
/**
 *  GM / Co-GM, or the owner of the character whose turn it is. Passes the turn in initiative
 *  order; after the last combatant a new round starts.
 */
{ kind: "next_turn"; combat_id: CombatId } | 
/**  GM / Co-GM. Removes the combat with its combatants. */
{ kind: "end_combat"; id: CombatId } | { kind: "create_token"; id: TokenId; map_id: MapId; character_id: CharacterId | null; asset_id: AssetId | null; name: string; x: number; y: number; rotation: number; scale: number; layer: TokenLayer; visible: boolean } | { kind: "update_token"; id: TokenId; name: string | null; rotation: number | null; scale: number | null; layer: TokenLayer | null; visible: boolean | null } | 
/**  Last-write-wins: no version check, does not bump the token version (ADR-0003). */
{ kind: "move_token"; id: TokenId; x: number; y: number } | { kind: "delete_token"; id: TokenId } | 
/**
 *  Players create their own `pc` in `draft` (owner = themselves); GM / Co-GM create any
 *  character directly as `active`.
 */
{ kind: "create_character"; id: CharacterId; character_kind: CharacterKind; name: string; owner: UserId | null; sheet_json: string } | { kind: "update_character"; id: CharacterId; name: string | null; sheet_json: string | null } | 
/**  draft → pending_approval (owner or GM). */
{ kind: "submit_character"; id: CharacterId } | 
/**  pending_approval → active (GM / Co-GM). */
{ kind: "approve_character"; id: CharacterId } | 
/**  pending_approval → draft, back to the player for changes (GM / Co-GM). */
{ kind: "return_character"; id: CharacterId } | 
/**  any → archived (GM / Co-GM). */
{ kind: "archive_character"; id: CharacterId } | 
/**  GM / Co-GM; `owner` must be a known user. */
{ kind: "assign_character_owner"; id: CharacterId; owner: UserId | null } | 
/**
 *  GM / Co-GM. Placed last in its folder. With `table` it is a table entry (ADR-0026) and
 *  `markdown` must be empty; an entry stays a text or a table for good.
 */
{ kind: "create_journal_entry"; id: JournalEntryId; folder_id: JournalFolderId | null; title: string; markdown: string; visibility: JournalVisibility; players_can_edit: boolean; table?: JournalTable | null } | 
/**
 *  GM / Co-GM change anything; players only `title`/`markdown`/`table` of entries that are
 *  visible to them and marked `players_can_edit`.
 */
{ kind: "update_journal_entry"; id: JournalEntryId; title: string | null; markdown: string | null; visibility: JournalVisibility | null; players_can_edit: boolean | null; 
/**  The whole table of a table entry (like `markdown` of a text). */
table?: JournalTable | null } | 
/**  GM / Co-GM: move into `folder_id` (`None`: the root) at position `sort_order`. */
{ kind: "move_journal_entry"; id: JournalEntryId; folder_id: JournalFolderId | null; sort_order: number } | 
/**  GM / Co-GM. */
{ kind: "delete_journal_entry"; id: JournalEntryId } | 
/**
 *  GM / Co-GM. A folder in `parent` (`None`: the root), last among its siblings. Sibling folders
 *  have different names (ADR-0021).
 */
{ kind: "create_journal_folder"; id: JournalFolderId; parent: JournalFolderId | null; name: string } | 
/**  GM / Co-GM. */
{ kind: "rename_journal_folder"; id: JournalFolderId; name: string } | 
/**  GM / Co-GM: into `parent` at `sort_order`; never into itself or its own subfolders. */
{ kind: "move_journal_folder"; id: JournalFolderId; parent: JournalFolderId | null; sort_order: number } | 
/**  GM / Co-GM. Deletes the folder with all its subfolders and entries. */
{ kind: "delete_journal_folder"; id: JournalFolderId } | 
/**
 *  GM / Co-GM. Records an image the server-side import already validated, converted and
 *  stored; the same original (`sha256`) cannot be registered twice.
 */
{ kind: "register_asset"; 
/**  Boxed: by far the largest intent payload (keeps `Intent` small). */
asset: AssetDto } | 
/**  Everyone except spectators. */
{ kind: "send_message"; id: ChatMessageId; body: string } | 
/**
 *  Everyone except spectators. `hidden` (seen by GM roles only) is for GM and Co-GM. Field
 *  references (`@str_mod`) read the sheet of `character_id`, which a player must own.
 */
{ kind: "roll_dice"; id: ChatMessageId; expression: string; hidden: boolean; character_id: CharacterId | null; 
/**
 *  A roll of the system (a sheet button): the core rolls the system's formula, and
 *  triggers know which roll it was (ADR-0024).
 */
roll: string | null } | 
/**
 *  The character's conditions (ids of the system's), replacing the current ones. GM roles,
 *  or the owner of an active or draft character.
 */
{ kind: "set_conditions"; id: CharacterId; conditions: string[] } | 
/**  GM / Co-GM: adds an item to the character's inventory list (the system's `inventory`). */
{ kind: "give_item"; id: CharacterId; name: string } | 
/**
 *  GM / Co-GM: installs (or replaces) a plugin in the campaign (ADR-0023). The client reads
