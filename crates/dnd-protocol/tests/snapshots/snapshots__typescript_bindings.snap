 */
{ kind: "install_plugin"; plugin: PluginDto } | 
/**  GM / Co-GM. The campaign's system plugin cannot be uninstalled. */
{ kind: "uninstall_plugin"; id: string } | 
/**  GM / Co-GM: the campaign's rules (`None`: no system, free-form sheets). */
{ kind: "set_system_plugin"; id: string | null } | 
/**  GM / Co-GM: a new board (ADR-0024), hidden from players until shown. */
{ kind: "create_board"; id: BoardId; name: string } | { kind: "update_board"; id: BoardId; name: string | null; visible_to_players: boolean | null } | 
/**  Deletes the board with its nodes and edges. */
{ kind: "delete_board"; id: BoardId } | { kind: "create_board_node"; id: BoardNodeId; board_id: BoardId; content: BoardNodeContent; x: number; y: number; width: number; height: number; visibility: BoardVisibility } | { kind: "update_board_node"; id: BoardNodeId; content: BoardNodeContent | null; width: number | null; height: number | null; visibility: BoardVisibility | null } | 
/**  Last-write-wins, like a token move (ADR-0003). */
{ kind: "move_board_node"; id: BoardNodeId; x: number; y: number } | 
/**  Deletes the node with its edges. */
{ kind: "delete_board_node"; id: BoardNodeId } | { kind: "create_board_edge"; id: BoardEdgeId; board_id: BoardId; from: BoardNodeId; to: BoardNodeId; label: string; directed: boolean; visibility: BoardVisibility } | { kind: "update_board_edge"; id: BoardEdgeId; label: string | null; directed: boolean | null; visibility: BoardVisibility | null } | { kind: "delete_board_edge"; id: BoardEdgeId } | 
/**  GM / Co-GM: a named area on a map for triggers (ADR-0024). */
{ kind: "create_zone"; id: ZoneId; map_id: MapId; name: string; shape: ZoneShape } | { kind: "update_zone"; id: ZoneId; name: string | null; shape: ZoneShape | null } | { kind: "delete_zone"; id: ZoneId } | 
/**
 *  Joins zones of the same map into `into` (its parts and theirs); the others are deleted and
 *  triggers watching them watch `into` instead.
 */
{ kind: "merge_zones"; into: ZoneId; from: ZoneId[] } | 
/**  GM / Co-GM: a trigger (ADR-0024). */
{ kind: "create_trigger"; id: TriggerId; definition: TriggerDef } | 
/**  Replaces the definition; a fired `once` trigger is armed again. */
{ kind: "update_trigger"; id: TriggerId; definition: TriggerDef } | { kind: "delete_trigger"; id: TriggerId } | 
/**  The GM's button: runs a `manual` trigger, for the character of `token` if given. */
{ kind: "fire_trigger"; id: TriggerId; token: TokenId | null } | 
/**  GM / Co-GM (ADR-0026). A folder in `parent` of the same library (`None`: its root). */
{ kind: "create_library_folder"; id: LibraryFolderId; library: Library; parent: LibraryFolderId | null; name: string } | 
/**  GM / Co-GM. */
{ kind: "rename_library_folder"; id: LibraryFolderId; name: string } | 
/**  GM / Co-GM: into `parent` of the same library, never into itself. */
{ kind: "move_library_folder"; id: LibraryFolderId; parent: LibraryFolderId | null } | 
/**  GM / Co-GM: the folder and its subfolders; their assets go back to the library's root. */
{ kind: "delete_library_folder"; id: LibraryFolderId } | 
/**  GM / Co-GM: into a folder of the asset's library (`None`: its root). */
{ kind: "move_asset"; id: AssetId; folder_id: LibraryFolderId | null } | 
/**  GM / Co-GM: the name shown in the library. */
{ kind: "rename_asset"; id: AssetId; name: string } | 
/**  GM / Co-GM: plays an audio asset to everyone. */
{ kind: "play_sound"; asset_id: AssetId; volume: number; looped: boolean } | 
/**  GM / Co-GM: stops a looping sound (`None`: all). */
{ kind: "stop_sound"; asset_id: AssetId | null };

/**  An intent together with its correlation id and the version it was based on (ADR-0003). */
export type IntentEnvelope = {
	intent_id: IntentId,
	/**
	 *  Required for intents that modify or delete an existing entity, except `move_token`
	 *  (last-write-wins). Ignored for creations.
	 */
	expected_version: Version | null,
	intent: Intent,
};

/**  Client-chosen identifier of an intent, used to correlate `Rejected`/`Events`. */
export type IntentId = string;

/**
 *  Result of submitting an intent. A rejection is an expected outcome, not an error.
 *  A repeated `intent_id` yields the original outcome again (ADR-0015).
 */
export type IntentOutcome = { status: "accepted"; 
/**  Sequence number of the last event produced. */
seq: Seq } | { status: "rejected"; reason: RejectReason };

/**
 *  Where a character's items live in the sheet: a list of objects at `path` whose `name_field`
 *  is the item's name (ADR-0024).
 */
export type InventoryDef = {
	path: string,
	name_field: string,
};

/**  A journal entry with its Markdown text. */
export type JournalEntryDto = {
	id: JournalEntryId,
	/**  The folder it is in; `None` for the root (ADR-0021). */
	folder_id: JournalFolderId | null,
	title: string,
	markdown: string,
	/**  Order inside the folder (ascending). */
	sort_order: number,
	visibility: JournalVisibility,
	/**  Players may edit it (only when visible to players). */
	players_can_edit: boolean,
	author: UserId | null,
	/**  The table of a table entry (`markdown` is then empty); `None` for a text (ADR-0026). */
	table?: JournalTable | null,
	version: Version,
};

/**  A journal entry. */
export type JournalEntryId = string;

/**  What a journal entry holds (ADR-0026). */
export type JournalEntryKind = 
/**  Markdown text. */
"text" | 
/**  A spreadsheet-like table. */
"table";

/**  A journal entry without its text, as listed in the snapshot (texts are fetched on demand). */
export type JournalEntryMeta = {
	id: JournalEntryId,
	folder_id: JournalFolderId | null,
	title: string,
	sort_order: number,
	visibility: JournalVisibility,
	players_can_edit: boolean,
	author: UserId | null,
	kind?: JournalEntryKind,
	version: Version,
};

/**  A folder of the journal (ADR-0021): folders nest; an empty folder exists on its own. */
export type JournalFolderDto = {
	id: JournalFolderId,
	/**  `None` for a folder at the root. */
	parent: JournalFolderId | null,
	name: string,
	/**  Order among its siblings (ascending). */
	sort_order: number,
	version: Version,
};

/**  A folder of the journal (ADR-0021). */
export type JournalFolderId = string;

/**
 *  A table entry of the journal (ADR-0026). Every row has one cell per column. A cell is the text
 *  the user typed; a cell starting with `=` is reserved for formulas (later).
 */
export type JournalTable = {
	columns: TableColumn[],
	rows: string[][],
};

/**  Who may read a journal entry. */
export type JournalVisibility = 
/**  GM and Co-GM only. */
"gm" | 
/**  Everyone in the campaign. */
"players";

/**  A user-visible text: one string for every language, or per language. */
export type Label = string | LocalizedText;

/**  Which library a folder belongs to: pictures (map and token images) or audio. */
export type Library = "images" | "audio";

/**
 *  A folder of a library. Folders nest; sibling names differ in more than case; they are sorted by
 *  name. GM roles only.
 */
export type LibraryFolderDto = {
	id: LibraryFolderId,
	library: Library,
	/**  `None` for a folder at the root of its library. */
	parent: LibraryFolderId | null,
	name: string,
	version: Version,
};

/**  A folder of the image or audio library (ADR-0026). */
export type LibraryFolderId = string;

/**  At least one of the languages is present. */
export type LocalizedText = {
	ru?: string | null,
	en?: string | null,
};

/**  A map. */
export type MapDto = {
	id: MapId,
	name: string,
	background_asset_id: AssetId | null,
	/**  Logical width (ADR-0016); fixed at creation. The background image is stretched onto it. */
	width: number,
	/**  Logical height (ADR-0016). */
	height: number,
	grid: Grid,
	visible_to_players: boolean,
	version: Version,
};

/**  A map inside the campaign. */
export type MapId = string;

/**  A plugin installed in the campaign. */
export type PluginDto = {
	id: string,
	/**  Semver, as in the manifest. */
	version: string,
	kind: PluginKind,
	name: Label,
	license: string,
	attribution: string | null,
	/**  Lowercase hex SHA-256 of the `.dndplugin` file (kept in the campaign's `plugins/`). */
	archive_sha256: string,
	/**  Present exactly for `kind: system`. */
	system: SystemRulesDto | null,
	/**  Trigger templates (ADR-0024); plugins installed before they existed have none. */
	trigger_templates?: TriggerTemplateDto[],
};

export type PluginKind = 
/**  Rules of the game: exactly one per campaign (ADR-0005). */
"system" | "content" | "theme" | "ui";

/**  Why an intent or message was rejected. The `code` tag is stable and safe to match on in clients. */
export type RejectReason = 
/**  `expected_version` did not match; `current` is the entity's version now (ADR-0003). */
{ code: "stale_version"; current: Version } | 
/**  A checked intent was sent without `expected_version`. */
{ code: "missing_expected_version" } | 
/**  The actor's role does not allow this intent. */
{ code: "forbidden" } | 
/**  The referenced entity does not exist. */
{ code: "not_found" } | 
/**  An entity with this id already exists. */
{ code: "already_exists" } | 
/**  The intent is malformed; `field` names the offending field. */
{ code: "invalid"; field: string } | 
/**
 *  The `intent_id` was already used for an intent with different data. Any retry with changed
 *  data (e.g. a new `expected_version`) needs a new `intent_id` (ADR-0015).
 */
{ code: "intent_id_reused" } | 
/**
 *  A size limit of the target would be exceeded (e.g. too many fog operations on a map);
 *  `limit` names it. Retrying the same intent cannot succeed.
 */
{ code: "limit_exceeded"; limit: string } | 
/**  Client and server speak different protocol versions. */
{ code: "protocol_mismatch"; server: number; client: number };

/**  An intent was not applied. */
export type Rejection = {
	intent_id: IntentId,
	reason: RejectReason,
};

/**  A generalized hit-point-like resource. `value` and `max` are expressions. */
export type ResourceDef = {
	id: string,
	label: Label,
	value: string,
	max: string,
};

/**  Something triggers can show to players. */
export type RevealTarget = 
/**  A board node becomes open to players. */
{ kind: "node"; id: BoardNodeId } | 
/**  A board is shown to players. */
{ kind: "board"; id: BoardId } | { kind: "map"; id: MapId } | 
/**  A journal entry is shared with players. */
{ kind: "journal"; id: JournalEntryId } | 
/**  A token becomes visible. */
{ kind: "token"; id: TokenId };

/**  Role of a participant (CLAUDE.md §5). */
export type Role = "gm" | "co_gm" | "player" | "spectator";

/**  A roll macro shown on the sheet. */
export type RollDef = {
	id: string,
	label: Label,
	dice: string,
};

/**
 *  Position of an event in the campaign/session event log.
 * 
 *  Exported to TypeScript as `number` (ADR-0007).
 */
export type Seq = number;

/**  Server → client. */
export type ServerMessage = { type: "events"; payload: EventBatch } | 
/**  Boxed: by far the largest message (keeps `ServerMessage` small). */
{ type: "snapshot"; payload: Snapshot } | 
/**
 *  The sender's intent was applied (or had been: a repeat, ADR-0015). Its events arrive in
 *  `events` like everyone else's.
 */
{ type: "accepted"; payload: Acceptance } | { type: "rejected"; payload: Rejection } | { type: "pong" } | 
/**
 *  Answer to `get_journal_entry`; `entry` is `None` when it is gone or not visible to the
 *  recipient.
 */
{ type: "journal_entry"; payload: {
	id: JournalEntryId,
	entry: JournalEntryDto | null,
} };

/**  The visible state as of event `seq`. */
export type Snapshot = {
	/**  Sequence number of the last event included (0 = no events yet). */
	seq: Seq,
	campaign: CampaignMeta,
	maps: MapDto[],
	tokens: TokenDto[],
	characters: CharacterDto[],
	users: UserDto[],
	/**  Journal index; texts are fetched per entry. */
	journal: JournalEntryMeta[],
	/**  Journal folders (ADR-0021). */
	journal_folders: JournalFolderDto[],
	assets: AssetDto[],
	/**  Fog of maps that have any (ADR-0019). */
	fog: FogDto[],
	/**  Combats and their combatants (ADR-0020). */
	combats: CombatDto[],
	combatants: CombatantDto[],
	/**  The last `CHAT_SNAPSHOT_LEN` chat messages, oldest first. */
	chat: ChatMessageDto[],
	/**  Plugins installed in the campaign (ADR-0023). */
	plugins: PluginDto[],
	/**  Id of the campaign's system plugin. */
	system_plugin: string | null,
	/**  Boards with their nodes and edges (ADR-0024). */
	boards: BoardDto[],
	board_nodes: BoardNodeDto[],
	board_edges: BoardEdgeDto[],
	/**  Zones on maps (GM roles only; empty for players). */
	zones: ZoneDto[],
	/**  Triggers (GM roles only; empty for players). */
	triggers: TriggerDto[],
	/**  Folders of the image and audio libraries (GM roles only; empty for players, ADR-0026). */
	library_folders?: LibraryFolderDto[],
	/**  Looping sounds playing now, so a client that (re)connects hears the same music. */
	sounds?: SoundDto[],
};

/**
 *  A sound being played to everyone. The file is the audio asset's own (`sha256`), named neither
 *  here nor to players: the hash is enough to fetch it (ADR-0026).
 */
export type SoundDto = {
	asset_id: AssetId,
	sha256: string,
	mime: string,
	/**  0..=`MAX_VOLUME`, scaled by each listener's own volume. */
	volume: number,
	/**  Plays until stopped (music); a sound that does not loop plays once. */
	looped: boolean,
};

/**  Messages the core posts; the UI localizes them by `code`. */
export type SystemMessage = { code: "character_submitted"; name: string } | { code: "character_approved"; name: string } | { code: "character_returned"; name: string } | 
/**  A trigger's narration line (ADR-0024). */
{ code: "narration"; text: string } | 
/**  A trigger changed a resource of the character `name` by `delta`. */
{ code: "resource_changed"; name: string; resource: string; delta: number } | 
/**  A trigger put a condition on (`added`) or took it off the character `name`. */
{ code: "condition_changed"; name: string; condition: string; added: boolean } | 
/**  The character `name` received an item. */
{ code: "item_given"; name: string; item: string };

/**  The rules of a system plugin, self-contained (no package paths). */
export type SystemRulesDto = {
	/**  Sheet data schema (JSON Schema subset, see `sheet_schema`). */
	sheet_schema: unknown,
	/**  Root layout node (rendered by the clients; the core only stores it). */
	sheet_layout: unknown,
	/**  Name → expression; results are integers. */
	computed: { [key in string]: string },
	/**  Dice expression for initiative. */
	initiative: string,
	resources: ResourceDef[],
	/**  Strictly descending percents: Healthy / Wounded / Critical / Dead boundaries. */
	health_thresholds: number[],
	rolls: RollDef[],
	/**  Conditions characters may have; rules installed before they existed have none. */
	conditions?: ConditionDef[],
	/**  The sheet list of items, if the system has one. */
	inventory?: InventoryDef | null,
};

/**  A column of a journal table. */
export type TableColumn = {
	name: string,
	/**  Width on screen, in CSS pixels (`MIN_COLUMN_WIDTH..=MAX_COLUMN_WIDTH`). */
	width: number,
};

/**  One blank of a trigger template. */
export type TemplateParam = {
	id: string,
	label: Label,
	kind: TemplateParamKind,
};

/**  What a template parameter asks for (the GM fills it in when creating the trigger). */
export type TemplateParamKind = "zone" | "board_node" | "board" | "map" | "journal" | "token" | 
/**  A roll of the system. */
"roll" | 
/**  A resource of the system. */
"resource" | 
/**  A condition of the system. */
"condition" | "number" | "text";

/**  A token on a map. */
export type TokenDto = {
	id: TokenId,
	map_id: MapId,
	character_id: CharacterId | null,
	asset_id: AssetId | null,
	name: string,
	/**  Position in 1/16 logical map units (ADR-0016), `0..=width*16`. */
	x: number,
	y: number,
	/**  Degrees, clockwise. */
	rotation: number,
	scale: number,
	layer: TokenLayer,
	visible: boolean,
	version: Version,
};

/**  A token placed on a map. */
export type TokenId = string;

/**  Rendering layer of a token. */
export type TokenLayer = 
/**  Below regular tokens (props, terrain). */
"background" | 
/**  Regular tokens. */
"tokens" | 
/**  Visible to GM / Co-GM only. */
"gm";

/**  What a trigger does, step by step. Character actions apply to the character who set it off. */
export type TriggerAction = 
/**  Shows something to players. */
{ type: "reveal"; target: RevealTarget } | 
/**  Hides a board node again (or opens it: any visibility). */
{ type: "set_node_visibility"; node: BoardNodeId; visibility: BoardVisibility } | 
/**  A narration line in the chat; `gm_only` keeps it from players. */
{ type: "chat"; text: string; gm_only: boolean } | 
/**  Rolls dice (with the character's fields); later steps see the total as `@roll`. */
{ type: "roll"; dice: string; label: string } | 
/**  Damage (`heal: false`) or healing by a dice roll, kept within 0..=max of the resource. */
{ type: "change_resource"; resource: string; dice: string; heal: boolean } | { type: "add_condition"; condition: string } | { type: "remove_condition"; condition: string } | { type: "give_item"; name: string } | 
/**  Plays an audio asset to everyone (ADR-0026). */
{ type: "play_sound"; asset: AssetId; volume: number; looped: boolean } | 
/**  Stops a looping sound; `None`: all sounds. */
{ type: "stop_sound"; asset: AssetId | null };

/**  What the GM edits: everything of a trigger but its id, state and version. */
export type TriggerDef = {
	name: string,
	enabled: boolean,
	/**  Fires at most once (until edited again). */
	once: boolean,
	event: TriggerEvent,
	/**  Tokens that may set it off; empty: any token of a character. */
	tokens: TokenId[],
	/**  Must hold (`dnd-expr` over the character's fields and `@total`) for the trigger to fire. */
	condition: string | null,
	steps: TriggerStep[],
};

/**  A trigger of the campaign. */
export type TriggerDto = {
	id: TriggerId,
	definition: TriggerDef,
	/**  A `once` trigger that already fired. */
	fired: boolean,
	version: Version,
};

/**  What sets a trigger off. */
export type TriggerEvent = 
/**
 *  A character whose token stands in `zone` made one of `rolls` (system roll ids; empty:
 *  any system roll). `@total` is the roll's total.
 */
{ type: "roll_in_zone"; zone: ZoneId; rolls: string[] } | 
/**  A token that was outside `zone` is now inside. */
{ type: "token_entered_zone"; zone: ZoneId } | 
/**  The GM's button (`fire_trigger`). */
{ type: "manual" } | 
/**  A character's inventory gained an item called `name` (ignoring case). */
{ type: "item_received"; name: string };

/**  Who set a trigger off (for the GM's log). */
export type TriggerFiredDto = {
	trigger: TriggerId,
	name: string,
	character: CharacterId | null,
	token: TokenId | null,
};

/**  A trigger: when → if → then, run by the core (ADR-0024). */
export type TriggerId = string;

/**  One action and, optionally, the expression that must hold for it to run. */
export type TriggerStep = {
	when: string | null,
	action: TriggerAction,
};

/**
 *  A ready-made trigger a plugin ships (`triggers/<name>.json`, ADR-0024): a trigger definition
 *  whose strings may contain `{{param}}` blanks. Data only; the trigger made from it is checked
 *  by the core like any other.
 */
export type TriggerTemplateDto = {
	id: string,
	name: Label,
	description: Label | null,
	params: TemplateParam[],
	/**  A `TriggerDef` with blanks (so not typed until they are filled). */
	definition: unknown,
};

/**  A user of the campaign. Read-only in stage 2a (users join through the session server, 2b). */
export type UserDto = {
	id: UserId,
	name: string,
	role: Role,
};

/**  A user known to the campaign (GM, players). */
export type UserId = string;

/**
 *  Optimistic-concurrency version of a mutable entity (ADR-0003). Starts at 1.
 * 
 *  Exported to TypeScript as `number`: versions never approach 2^53 (ADR-0007).
 */
export type Version = number;

/**  A named zone on a map. */
export type ZoneDto = {
	id: ZoneId,
	map_id: MapId,
	name: string,
	shape: ZoneShape,
	version: Version,
};

/**  A named area on a map that triggers watch (ADR-0024). */
export type ZoneId = string;

/**  The area of a zone, in Units16 (ADR-0016). */
export type ZoneShape = 
/**  Axis-aligned rectangle with its top-left corner at (`x`, `y`). */
{ type: "rect"; x: number; y: number; width: number; height: number } | 
/**  A closed polygon: flat `[x0, y0, x1, y1, …]`, 3..=[`MAX_ZONE_POINTS`] points. */
{ type: "polygon"; points: number[] } | 
/**  Several rectangles and polygons (not unions) taken together: a zone added to or merged. */
{ type: "union"; parts: ZoneShape[] };
