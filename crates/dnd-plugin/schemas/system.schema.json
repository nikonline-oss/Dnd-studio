{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dndstudio system.json (rules of a system plugin)",
  "type": "object",
  "additionalProperties": false,
  "required": ["sheet", "initiative"],
  "properties": {
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "layout"],
      "properties": {
        "schema": {
          "$ref": "#/$defs/sheet_file"
        },
        "layout": {
          "$ref": "#/$defs/sheet_file"
        }
      }
    },
    "computed": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "$ref": "#/$defs/expression"
      }
    },
    "initiative": {
      "$ref": "#/$defs/dice"
    },
    "resources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "value", "max"],
        "properties": {
          "id": {
            "$ref": "#/$defs/ident"
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "value": {
            "$ref": "#/$defs/expression"
          },
          "max": {
            "$ref": "#/$defs/expression"
          }
        }
      }
    },
    "health_thresholds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    },
    "rolls": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "dice"],
        "properties": {
          "id": {
            "$ref": "#/$defs/ident"
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "dice": {
            "$ref": "#/$defs/dice"
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}$"
          },
          "label": {
            "$ref": "#/$defs/label"
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name_field"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
          "maxLength": 128
        },
        "name_field": {
          "$ref": "#/$defs/ident"
        }
      }
    }
  },
  "$defs": {
    "ident": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "maxLength": 64
    },
    "sheet_file": {
      "type": "string",
      "pattern": "^sheet/[a-z0-9][a-z0-9._-]*\\.json$",
      "maxLength": 128
    },
    "expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "dice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "label": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "ru": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      ]
    }
  }
}
