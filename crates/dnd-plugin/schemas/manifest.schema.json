{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dndstudio plugin manifest.json, format 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "name", "version", "kind", "authors", "license", "app_compat"],
  "properties": {
    "format": { "const": 1 },
    "id": { "$ref": "#/$defs/plugin_id" },
    "name": { "$ref": "#/$defs/label" },
    "version": { "type": "string", "minLength": 5, "maxLength": 64 },
    "kind": { "enum": ["system", "content", "theme", "ui"] },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 128 },
    "attribution": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "app_compat": { "type": "string", "minLength": 1, "maxLength": 128 },
    "dependencies": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/$defs/plugin_id" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  },
  "$defs": {
    "plugin_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "maxLength": 64 },
    "label": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 200 },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "ru": { "type": "string", "minLength": 1, "maxLength": 200 },
            "en": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      ]
    }
  }
}
