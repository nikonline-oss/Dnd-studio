{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dndstudio compendium (compendia/*.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "entry_type", "entries"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "name": { "$ref": "#/$defs/label" },
    "entry_type": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 64 },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "data"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/label" },
          "data": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 64 },
    "label": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 200 },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "ru": { "type": "string", "minLength": 1, "maxLength": 200 },
            "en": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      ]
    }
  }
}
