{
  "sheet": {
    "schema": "sheet/schema.json",
    "layout": "sheet/layout.json"
  },
  "computed": {
    "prof": "2 + floor((@level - 1) / 4)",
    "str_mod": "floor((@abilities.str - 10) / 2)",
    "str_save": "@str_mod + (if @saves.str then @prof else 0)",
    "dex_mod": "floor((@abilities.dex - 10) / 2)",
    "dex_save": "@dex_mod + (if @saves.dex then @prof else 0)",
    "con_mod": "floor((@abilities.con - 10) / 2)",
    "con_save": "@con_mod + (if @saves.con then @prof else 0)",
    "int_mod": "floor((@abilities.int - 10) / 2)",
    "int_save": "@int_mod + (if @saves.int then @prof else 0)",
    "wis_mod": "floor((@abilities.wis - 10) / 2)",
    "wis_save": "@wis_mod + (if @saves.wis then @prof else 0)",
    "cha_mod": "floor((@abilities.cha - 10) / 2)",
    "cha_save": "@cha_mod + (if @saves.cha then @prof else 0)",
    "acrobatics": "@dex_mod + (if @skills.acrobatics then @prof else 0)",
    "animal_handling": "@wis_mod + (if @skills.animal_handling then @prof else 0)",
    "arcana": "@int_mod + (if @skills.arcana then @prof else 0)",
    "athletics": "@str_mod + (if @skills.athletics then @prof else 0)",
    "deception": "@cha_mod + (if @skills.deception then @prof else 0)",
    "history": "@int_mod + (if @skills.history then @prof else 0)",
    "insight": "@wis_mod + (if @skills.insight then @prof else 0)",
    "intimidation": "@cha_mod + (if @skills.intimidation then @prof else 0)",
    "investigation": "@int_mod + (if @skills.investigation then @prof else 0)",
    "medicine": "@wis_mod + (if @skills.medicine then @prof else 0)",
    "nature": "@int_mod + (if @skills.nature then @prof else 0)",
    "perception": "@wis_mod + (if @skills.perception then @prof else 0)",
    "performance": "@cha_mod + (if @skills.performance then @prof else 0)",
    "persuasion": "@cha_mod + (if @skills.persuasion then @prof else 0)",
    "religion": "@int_mod + (if @skills.religion then @prof else 0)",
    "sleight_of_hand": "@dex_mod + (if @skills.sleight_of_hand then @prof else 0)",
    "stealth": "@dex_mod + (if @skills.stealth then @prof else 0)",
    "survival": "@wis_mod + (if @skills.survival then @prof else 0)",
    "passive_perception": "10 + @perception"
  },
  "initiative": "1d20 + @dex_mod",
  "resources": [
    {
      "id": "hp",
      "label": {
        "ru": "Хиты",
        "en": "Hit points"
      },
      "value": "@hp.current",
      "max": "@hp.max"
    }
  ],
  "health_thresholds": [75, 25, 0],
  "rolls": [
    {
      "id": "str_check",
      "label": {
        "ru": "Проверка: Сила",
        "en": "Strength check"
      },
      "dice": "1d20 + @str_mod"
    },
    {
      "id": "str_save",
      "label": {
        "ru": "Спасбросок: Сила",
        "en": "Strength save"
      },
      "dice": "1d20 + @str_save"
    },
    {
