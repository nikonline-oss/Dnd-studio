  "features": [
    {
      "id": "opportunity_attacks",
      "label": {
        "ru": "Провоцированные атаки",
        "en": "Opportunity attacks"
      },
      "description": {
        "ru": "Предлагать реакцию при выходе из досягаемости. Решение подтверждает владелец или мастер.",
        "en": "Offer a reaction before a creature leaves reach. Controller or GM confirms."
      },
      "default_enabled": true
    },
    {
      "id": "area_actions",
      "label": {
        "ru": "Действия по области",
        "en": "Area actions"
      },
      "description": {
        "ru": "Разрешить действия с областью поражения и эффектами на карте.",
        "en": "Enable area actions and map effects."
      },
      "default_enabled": true
    },
    {
      "id": "condition_rules",
      "label": {
        "ru": "Последствия состояний",
        "en": "Condition consequences"
      },
      "description": {
        "ru": "Автоматически применять объявленные плагином ограничения и модификаторы состояний.",
        "en": "Apply the condition restrictions and modifiers declared by the plugin."
      },
      "default_enabled": true
    },
    {
      "id": "disengage",
      "label": {
        "ru": "Отход",
        "en": "Disengage"
      },
      "description": {
        "ru": "Действие даёт защиту от провоцирования до конца текущего хода.",
        "en": "An action prevents provoking until the current turn ends."
      },
      "default_enabled": true
    },
    {
      "id": "damage_rules",
      "label": {
        "ru": "Защита и временные хиты",
        "en": "Damage defenses and temporary hit points"
      },
      "description": {
        "ru": "Применять снижение, сопротивления, уязвимости, иммунитеты и временные хиты.",
        "en": "Apply reduction, resistance, vulnerability, immunity and temporary hit points."
      },
      "default_enabled": true
    },
    {
      "id": "concentration",
      "label": {
        "ru": "Концентрация",
        "en": "Concentration"
      },
      "description": {
        "ru": "Поддерживаемые эффекты, проверки при уроне и завершение при недееспособности.",
        "en": "Maintained effects, damage saves and ending on incapacity."
      },
      "default_enabled": true
    },
    {
      "id": "counterspell",
      "label": {
        "ru": "Контрзаклинание",
        "en": "Counterspell"
      },
      "description": {
        "ru": "Предлагать реакцию на произнесение заклинания; разрешать цепочки прерываний.",
        "en": "Offer a reaction to spellcasting and resolve interruption chains."
      },
      "default_enabled": true
    },
    {
      "id": "turn_economy",
      "label": {
        "ru": "Экономика хода",
        "en": "Turn economy"
      },
      "description": {
        "ru": "Свой ход для действий, восстановление бюджетов и не больше одной ячейки за ход.",
        "en": "Own-turn actions, budget resets and at most one spell slot per turn."
      },
      "default_enabled": true
    },
    {
      "id": "spatial_rules",
      "label": {
        "ru": "Преграды и обзор",
        "en": "Obstacles and sight"
      },
      "description": {
        "ru": "Проверять зоны, блокирующие обзор или эффект. Освещение, особые чувства и частичное укрытие мастер учитывает отдельно.",
        "en": "Check zones blocking sight or effect. Lighting, special senses and partial cover are adjudicated separately."
      },
      "default_enabled": true
    }
  ],
