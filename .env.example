# Copy to .env (never commit .env). Only DND_HOST_TOKEN is required.

# Who may upload campaigns to this server: a long random secret (at least 16 characters).
# Generate one with: openssl rand -base64 32
DND_HOST_TOKEN=change-me-to-a-long-random-secret

# Port on the host.
DND_PORT=8080

# Host interface the published port binds to. With the TLS profile set 127.0.0.1 so the only way in
# is through Caddy.
# DND_BIND_ADDR=127.0.0.1

# Domain for the optional Caddy profile (docker compose --profile tls up -d).
# DND_DOMAIN=dnd.example.org

# Base of invite links when the server is reached through a proxy, e.g. https://dnd.example.org
# DND_PUBLIC_URL=

# Use a published image instead of building locally:
#   DND_SERVER_IMAGE=ghcr.io/OWNER/REPO/session-server:0.1.0 docker compose up -d --pull always --no-build
# DND_SERVER_IMAGE=

# Limits (CLAUDE.md §7 defaults).
# DND_MAX_SESSIONS=100
# DND_MAX_PARTICIPANTS=20
# DND_SESSION_TTL_SECS=3600
# DND_CONNECTIONS_PER_MINUTE=10
# DND_MESSAGES_PER_MINUTE=100
# DND_MAX_UPLOAD_MB=1024
