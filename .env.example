# Copy to .env (never commit .env). Only DND_HOST_TOKEN is required.

# Who may upload campaigns to this server: a long random secret (at least 16 characters).
DND_HOST_TOKEN=change-me-to-a-long-random-secret

# Port on the host.
DND_PORT=8080

# Base of invite links when the server is reached through a proxy, e.g. https://dnd.example.org
# DND_PUBLIC_URL=

# Limits (CLAUDE.md §7 defaults).
# DND_MAX_SESSIONS=100
# DND_MAX_PARTICIPANTS=20
# DND_SESSION_TTL_SECS=3600
# DND_CONNECTIONS_PER_MINUTE=10
# DND_MESSAGES_PER_MINUTE=100
# DND_MAX_UPLOAD_MB=1024
